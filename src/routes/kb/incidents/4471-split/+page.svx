<script>
  import reports from '#lib/data/reports-4471.json';
  import notes from '#lib/data/desk-notes.json';
  import { groupByCause, readAs, uniqueById } from '#lib/kb/causes';
  import { tenantOf } from '#lib/kb/locales';
  import CauseTable from '#lib/kb/CauseTable.svelte';
  import Callout from '#lib/kb/Callout.svelte';
  import RenderStamp from '#lib/kb/RenderStamp.svelte';

  // The desk's own view of #4471, as exported: one id, one report; the cause comes from the tenant.
  const merged = uniqueById(reports).filter((r) => r.mergedInto === 4471);
  const groups = groupByCause(merged, tenantOf);
  const group = (cause) => groups.find((g) => g.cause === cause);
  const filed = (cause) => group(cause)?.reports ?? [];
  // As the desk counts: a report the desk read differently stays counted where it is filed.
  const moved = readAs(group('parser'), notes.oneDayMove);

  const issues = 'https://github.com/jexor23/mega-s01e03-what-it-shows/issues';
  const tickets = [
    { n: 1, problem: 'The shared parser reads day-first dates month first', reports: filed('parser') },
    { n: 2, problem: 'The booking-v3 form hints MM/DD/YYYY to day-first tenants', reports: filed('hint') },
    { n: 3, problem: 'Dates move by one day', reports: merged.filter((r) => notes.oneDayMove.includes(r.id)), footnote: true },
  ];
  const placed = groups.reduce((n, g) => n + g.reports.length, 0);
  const tenants = (rs) => new Set(rs.map((r) => r.tenant)).size;
  const seen = (rs) => {
    const days = rs.map((r) => r.receivedAt.slice(0, 10)).sort();
    return `${days[0]} → ${days[days.length - 1]}`;
  };
  const intakeDisagrees = groups.reduce((n, g) => n + g.reports.filter((r) => r.meta.intakeTag !== g.cause).length, 0);
</script>

The desk merged **{merged.length} reports** into #4471 as one issue and marked it known. Its own
view of the ticket, rendered below from the export, already shows more than one problem: two
causes, and a note about reports that read as a one-day move.

